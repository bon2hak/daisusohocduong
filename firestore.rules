rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Posts: public read, authenticated or verified write
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.title != null;
      allow update, delete: if true;
    }

    // Email permissions: critical security collection
    match /email_permissions/{permId} {
      allow read: if true;
      allow write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
